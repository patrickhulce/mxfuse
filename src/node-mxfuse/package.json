{
  "name": "mxfuse",
  "version": "0.1.0",
  "description": "Read and write MXF files through a statically linked bmx core",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": "mxfuse contributors",
  "homepage": "https://github.com/patrickhulce/mxfuse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patrickhulce/mxfuse.git"
  },
  "bugs": {
    "url": "https://github.com/patrickhulce/mxfuse/issues"
  },
  "keywords": [
    "mxf",
    "bmx",
    "media",
    "container"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "binding.js",
    "binding.d.ts",
    "mxfuse.*.node",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build:native": "napi build --cargo-name mxfuse_node_bindings --platform --release --js binding.js --dts binding.d.ts",
    "build:ts": "tsc",
    "build": "pnpm run build:native && pnpm run build:ts",
    "build:debug": "napi build --cargo-name mxfuse_node_bindings --platform --js binding.js --dts binding.d.ts && pnpm run build:ts",
    "test": "node --import tsx --test test/api.test.ts",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "artifacts:check": "../../scripts/check-napi-artifacts.sh",
    "prepublishOnly": "bash ../../scripts/sync-package-licenses.sh && pnpm run artifacts:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "napi": {
    "name": "mxfuse",
    "binaryName": "mxfuse",
    "packageName": "mxfuse",
    "triples": {
      "defaults": false,
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu"
      ]
    },
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  }
}
